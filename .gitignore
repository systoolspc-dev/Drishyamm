# DrishyamVMS — root .gitignore
# Sub-projects (backend/, frontend/, mobile/, ai/*) keep their own .gitignore
# for stack-specific rules; this file covers repo-wide concerns.
# Model weights / demo media are NOT ignored — they go through Git LFS
# (see .gitattributes).

# ── secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*
# templates with placeholder values ARE committed
!.env.example
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
deploy/cloudflared/credentials/*
!deploy/cloudflared/credentials/.gitkeep
deploy/gpu-bridge/keys/
deploy/certs/
docker-compose.override.yml

# ── runtime data (biometric photos, recordings, local models) ───────────────
data/recordings/*
data/known-faces/*
data/ai-models/*
!data/**/.gitkeep
backups/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# raw camera footage (demo clips that ARE kept are .mp4/.webm via LFS)
*.mov
*.avi
*.mkv
*.mpg

# ── ML training scratch ─────────────────────────────────────────────────────
# Only curated best.pt + run metrics are committed; everything else is regenerable.
last.pt
epoch*.pt
*.cache
wandb/
mlruns/
lightning_logs/
.ipynb_checkpoints/
**/dataset/images/
**/dataset/labels/
# TensorRT engine caches are GPU-specific; rebuilt on first start
models/insightface/trt_cache/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ── Node / JS ───────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
web-build*/
.expo/
.vite/
.npm/
.eslintcache
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── logs / temp ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/
.cache/
*.tmp
*.bak
*.orig
# Windows: accidental `> nul` redirects from Git Bash create a real file
nul

# ── local agent / tooling state ─────────────────────────────────────────────
.claude/*
# Project skills ARE shared: they hold the deploy runbook (see docs/DEPLOYMENT.md).
!.claude/skills/
.playwright-mcp/

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
