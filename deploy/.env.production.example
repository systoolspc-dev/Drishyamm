# ============================================================================
# DrishyamVMS — PRODUCTION secrets template  (root .env)
# ============================================================================
# Copy to `.env` in the repo root (git-ignored) and fill EVERY value below with
# a strong, unique secret. Leaving a value blank/at its dev default keeps that
# datastore UNAUTHENTICATED — acceptable for local dev, never for production.
#
# Generate strong values:
#   openssl rand -hex 32            # for passwords / API keys
#   openssl rand -base64 48         # for JWT secrets
#
# After first boot the datastore volumes are already initialized. Changing a
# password here only affects a FRESH volume — to rotate an existing store you
# must ALTER the credential inside the running container too (see SECURITY.md §4).
# ----------------------------------------------------------------------------

# ── MySQL (operational DB: users, cameras, billing) ─────────────────────────
# Set BOTH: a strong root password AND flip allow-empty OFF.
MYSQL_ROOT_PASSWORD=__set_a_strong_password__
MYSQL_ALLOW_EMPTY_PASSWORD=no
# The backend connects as root; it reads MYSQL_ROOT_PASSWORD automatically.

# ── PostgreSQL (vms_face: face/body vectors, journey) ───────────────────────
POSTGRES_USER=vms
POSTGRES_PASSWORD=__set_a_strong_password__

# ── Redis (stream ownership, BullMQ queues, HMAC tokens, cache) ─────────────
# One value secures every consumer — each REDIS_URL in compose reads it.
REDIS_PASSWORD=__set_a_strong_password__

# ── Qdrant (vector store — biometric embeddings) ────────────────────────────
# Enables API-key auth on Qdrant; consumers send it as the api-key header.
QDRANT_API_KEY=__set_a_strong_api_key__

# ── MinIO / object storage (snapshots, stitched clips) ──────────────────────
MINIO_ROOT_USER=__set_a_strong_access_key__
MINIO_ROOT_PASSWORD=__set_a_strong_secret_key__

# ── MediaMTX streaming control API ──────────────────────────────────────────
# NOTE: MediaMTX does NOT expand ${VAR} inside mediamtx.yml. This var updates the
# TRANSCODER's client only — you must ALSO edit the `pass:` field in mediamtx.yml
# to the same value. See SECURITY.md §4. The API is loopback-bound (127.0.0.1).
MEDIAMTX_API_USER=drishyam
MEDIAMTX_API_PASS=__set_a_strong_password__

# ── App secrets (backend) ───────────────────────────────────────────────────
# JWT_SECRET and JWT_REFRESH_SECRET MUST differ and be 32+ random bytes.
# The backend refuses to boot in production if these are dev/default values
# (see smart-cam-backend/src/config/prodSecretGuard.js).
JWT_SECRET=__openssl_rand_base64_48__
JWT_REFRESH_SECRET=__a_DIFFERENT_openssl_rand_base64_48__

# Service-to-service token for internal routes (person-tracker proxy etc.)
PERSON_TRACKER_SERVICE_TOKEN=__set_a_32+_char_token__
SERVICE_TOKEN=__set_a_32+_char_token__

# ── Field encryption key for camera credentials (AES-256-GCM) ───────────────
# 32-byte hex. Set the SAME value for both the Node backend and the Python AI
# service, or they cannot decrypt each other's stored camera passwords.
# WARNING: losing this key makes every encrypted camera password unrecoverable.
CAMERA_CRED_KEY=__openssl_rand_hex_32__
VMS_CAMERA_CRED_KEY=__same_value_as_CAMERA_CRED_KEY__

# ── Stream URL signing (HMAC per-camera stream tokens) ──────────────────────
STREAM_URL_SECRET=__openssl_rand_hex_32__

# ── Payment / third-party (only if used) ────────────────────────────────────
STRIPE_SECRET_KEY=
RAZORPAY_KEY_SECRET=

# ── LiveKit / TURN (only if used) ───────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SHARED_SECRET=
