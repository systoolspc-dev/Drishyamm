# Copy to .env and edit as needed.
#
# Canonical defaults live in config/settings.py. The values shown below MUST
# match the Python defaults — when you change one, change both. Operators
# overriding a value should set it in .env (this file is for documentation
# only). Treat this file as a comment-rich index of every supported env var.

# --- Service identity ---
VMS_ENV=dev
VMS_LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DSN=postgresql+asyncpg://vms:vms@localhost:5432/vms_face
POSTGRES_DSN_SYNC=postgresql+psycopg2://vms:vms@localhost:5432/vms_face

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Legacy single-collection name (kept for compatibility)
QDRANT_COLLECTION=faces
# Dual-collection split (research memory 2026-05-07)
# Enrolled gallery: small/hot/replicated, queried for live alerts.
# Appearance log: large/time-partitioned, queried for forensic search.
QDRANT_COLLECTION_ENROLLED=vms_enrolled
QDRANT_COLLECTION_APPEARANCE=vms_appearance
QDRANT_APPEARANCE_ENABLED=true
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE=Cosine

# --- Redis (event bus + live overlay pub/sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_DETECTIONS=vms.detections
REDIS_STREAM_ALERTS=vms.alerts
REDIS_STREAM_DETECTIONS_DLQ=vms.detections.dlq
REDIS_CONSUMER_GROUP=match-workers
REDIS_CAM_STATE_CHANNEL=vms.cam.state
REDIS_CAM_STATE_KEY_PREFIX=vms:cam:state:
REDIS_CAM_STATE_TTL_SEC=30

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_SNAPSHOTS=vms-snapshots
MINIO_BUCKET_ENROLLMENTS=vms-enrollments

# --- InsightFace runtime ---
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=960
INSIGHTFACE_CTX_ID=0
INSIGHTFACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
INSIGHTFACE_DET_THRESHOLD=0.5
# Default threshold is for the InsightFace ArcFace head (cosine on buffalo_l
# embeddings). When RECOGNIZER_BACKEND=adaface, set RECOGNIZER_ADAFACE_THRESHOLD
# instead — AdaFace lives in a different cosine regime (~0.30-0.40 typical).
INSIGHTFACE_REC_THRESHOLD=0.62
# After a CUDA execution-provider failure the runtime serves from CPU and
# retries CUDA after this cooldown. Set to 0 to disable retries (CPU latch).
INSIGHTFACE_CUDA_RETRY_SEC=60.0
# buffalo_l ships 2d106det.onnx + 1k3d68.onnx — auxiliary landmark heads we
# never read on the hot path. False saves ~150 MB GPU memory and 3-5 ms per
# face. Set true only if you re-enable a feature that uses them.
INSIGHTFACE_LOAD_AUX_LANDMARKS=false
# Eager FaceRuntime warmup at API startup. Default false because the
# production deployment runs orchestrators in their own processes — the API
# never runs detection itself, and the buffalo_l load wastes ~600 MB GPU.
# Set true for single-process dev (API also runs in-process orchestrators).
API_WARMUP_FACE_RUNTIME=false

# --- Batched ONNX inference ---
# When true, in-flight detect() and embed() calls across cameras coalesce
# into single ONNX Runtime calls. Trades a small constant latency (the
# coalescing window) for 3-5x detect throughput and ~2x embed throughput.
#
# IMPORTANT: the batched detect path goes straight to the SCRFD session and
# does NOT run buffalo_l's bundled ArcFace head. RECOGNIZER_BACKEND=adaface
# (or another standalone recognizer) is therefore required when this is on.
# RECOGNIZER_BACKEND=insightface fails settings.assert_consistent() at boot.
PIPELINE_BATCHED_INFERENCE=false
BATCH_DETECT_MAX=8
BATCH_DETECT_WINDOW_MS=3.0
BATCH_EMBED_MAX=16
BATCH_EMBED_WINDOW_MS=2.0

# --- Recognizer backend ---
# "insightface" = use buffalo_l's bundled ArcFace head (default, fastest)
# "adaface"     = swap to AdaFace ONNX (better on low-res / surveillance faces)
# Switching backends INVALIDATES the gallery; re-enroll all persons after switch.
RECOGNIZER_BACKEND=insightface
ADAFACE_MODEL_PATH=

# AdaFace cosine threshold. Used when RECOGNIZER_BACKEND=adaface; ignored
# otherwise. AdaFace lives in a different similarity regime than ArcFace
# (typically 0.30-0.45 for same-identity), so it has its own knob.
RECOGNIZER_ADAFACE_THRESHOLD=0.35

# --- Track-level embedding pooling (multi-frame fusion) ---
TRACK_POOL_TOP_K=5
TRACK_MIN_HITS_TO_MATCH=3
# Quality floor on pool admission (roadmap A4). Crops below this composite
# quality never pool — a track that only produced garbage crops publishes
# nothing rather than a garbage pooled embedding. 0 disables the floor.
TRACK_POOL_MIN_QUALITY=0.30

# --- Face attributes (gender / age) ---
# Per-track quality-weighted vote over genderage outputs. Single-frame gender
# on CCTV crops flips constantly; the vote asserts a label only after
# ATTRIBUTES_MIN_VOTES samples with ATTRIBUTES_MIN_AGREEMENT weighted
# majority. Drives the overlay gender/age, FaceCandidate.extra, and the
# people-count male/female breakdown.
FACE_ATTRIBUTES_ENABLED=true
# Run the genderage head on demand (per track, until the vote settles)
# instead of inside FaceAnalysis.get() on every face every frame. Also the
# only way gender works when PIPELINE_BATCHED_INFERENCE=true.
INSIGHTFACE_ONDEMAND_GENDERAGE=true
ATTRIBUTES_MIN_FACE_PX=48
ATTRIBUTES_MIN_VOTES=3
ATTRIBUTES_MAX_VOTES=8
ATTRIBUTES_MIN_AGREEMENT=0.70

# --- Quality gate ---
QUALITY_MIN_FACE_PX=40
QUALITY_MIN_DET_SCORE=0.6
QUALITY_MAX_BLUR_VAR=0.0          # 0 disables blur enforcement
# NOTE: as of the 64x64 downsample optimization, Laplacian variance on the
# downsampled crop differs from the full-crop value by a roughly constant
# factor. Operators who calibrated this threshold pre-downsample should
# re-tune against current `vms_quality_rejects_total{reason="blurry"}` rates.
QUALITY_MAX_YAW_DEG=45
QUALITY_MAX_PITCH_DEG=30
QUALITY_MIN_BRIGHTNESS=15.0
QUALITY_MAX_BRIGHTNESS=240.0

# --- Tracker (SORT/DeepSORT-style: Kalman + Hungarian + appearance) ---
TRACKER_IOU_THRESHOLD=0.3
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=3
# Weight given to the cosine-similarity term in the assignment cost (vs IoU).
# 0.0 = pure SORT (IoU only), 0.4-0.6 ≈ DeepSORT.
TRACKER_APPEARANCE_WEIGHT=0.4
# EWMA factor for the per-track smoothed embedding (higher = more inertia).
TRACKER_APPEARANCE_ALPHA=0.7

# --- Pipeline ---
TARGET_FPS=8
EMBED_EVERY_N_FRAMES=5
SNAPSHOT_TOP_K_PER_TRACK=3
# Per-orchestrator cap on concurrent _handle_tracked tasks within one frame.
# Higher = better single-frame throughput on crowded scenes; bounded so a
# 100-face frame doesn't oversubscribe the GPU pool.
PIPELINE_FACE_CONCURRENCY=8

# --- Person detection (YOLOv8) — runs alongside face detection ---
# Counts humans regardless of face visibility — catches back-of-head,
# heavily occluded, and side-profile people that SCRFD alone misses.
# When enabled the cache uses MAX(persons_present, active_tracks, faces)
# as the "people count" total, so the count goes up but never down.
#
# Model setup: get yolov8n.onnx and place it where the container can read it.
#   1. pip install ultralytics
#   2. yolo export model=yolov8n.pt format=onnx imgsz=640 simplify=True
#   3. cp yolov8n.onnx ./smart-cam-ai/data/models/yolov8n.onnx
#     (that path is bind-mounted to /srv/data/models inside the container)
#
# Or download a pre-exported ONNX from
# https://github.com/ultralytics/assets/releases (yolov8n.onnx, ~6 MB).
PIPELINE_PERSON_DETECTION_ENABLED=false
PIPELINE_PERSON_MODEL_PATH=
PIPELINE_PERSON_THRESHOLD=0.35
PIPELINE_PERSON_DET_SIZE=640
# Run YOLO every Nth frame (8fps × 1/2 = 4fps effective). Reuse last value
# in between. Lower = smoother count, higher = less GPU spent.
PIPELINE_PERSON_DETECT_EVERY_N_FRAMES=2

# --- Motion gate (roadmap E.3) — skip SCRFD on static empty scenes ---
# A ~0.2 ms CPU frame-difference check runs before the detector; when the
# scene is static AND no tracks are alive the detect is skipped. On quiet
# cameras this removes 70-95% of detect GPU. Never skips while tracks are
# alive; a full detect always runs at least every MOTION_GATE_MAX_SKIP_FRAMES.
# Watch vms_motion_gate_skips_total after enabling. Great for parking lots
# and after-hours corridors; leave off for high-stakes ingress points if the
# ~1-frame first-detect latency after motion starts matters to you.
MOTION_GATE_ENABLED=false
MOTION_GATE_DOWNSCALE_WIDTH=160
MOTION_GATE_PIXEL_DELTA=26
MOTION_GATE_MIN_CHANGED_FRAC=0.004
MOTION_GATE_MAX_SKIP_FRAMES=15
# Snapshot JPEG quality. 80 is visually indistinguishable from 88 on face
# crops at typical sizes; gives ~30% smaller files / ~25% faster encode.
# Raise to 88-92 only for evidence-grade requirements.
SNAPSHOT_JPEG_QUALITY=80
PIPELINE_FRAME_TIMEOUT_SEC=1.5
# NVIDIA NVDEC hardware decode for RTSP. Empty = software (CPU) decode.
# Set "cuda" to offload H.264/H.265 decode to the GPU's video-decode block.
# Drops CPU per camera by 30-60% on Blackwell; "Video Decode" graph in
# Task Manager goes from 0% to active. Requires FFmpeg built with
# --enable-cuvid (the nvidia/cuda runtime image we use already has it).
RTSP_HWACCEL=
PIPELINE_RTSP_REOPEN_BACKOFF_SEC=2.0
PIPELINE_RTSP_REOPEN_MAX_BACKOFF_SEC=30.0
# "redis" (default) routes per-camera live overlay through Redis Pub/Sub so
# multi-process deployments share the live view. "local" keeps it in-process
# only — use only when API + orchestrators run in the same Python process.
CACHE_BACKEND=redis

# --- Match worker ---
MATCH_WORKER_CONCURRENCY=32
MATCH_WORKER_AUTOCLAIM_MIN_IDLE_MS=60000
MATCH_WORKER_AUTOCLAIM_INTERVAL_SEC=15.0
MATCH_WORKER_APPEARANCE_LOG=true

# --- Supervised face learning ---
# Pending samples become enrolled-gallery candidates only after operator
# approval. Tighter thresholds = fewer suggestions, higher signal.
FACE_LEARNING_ENABLED=true
FACE_LEARNING_MIN_SIMILARITY=0.68
FACE_LEARNING_MIN_QUALITY=0.60
FACE_LEARNING_MIN_FACE_PX=96
FACE_LEARNING_MIN_BLUR_VAR=45.0
FACE_LEARNING_MAX_SAMPLES_PER_TRACK=6
FACE_LEARNING_MAX_PENDING_PER_PERSON=100
FACE_LEARNING_DUPLICATE_SIMILARITY=0.985

# --- Retention worker (DPDP) ---
RETENTION_WORKER_ENABLED=true
RETENTION_WORKER_INTERVAL_SEC=3600
RETENTION_EVENT_DAYS=90
RETENTION_SNAPSHOT_DAYS=7
RETENTION_AUDIT_LOG_DAYS=365

# --- System metrics poller (psutil + pynvml) ---
SYSTEM_METRICS_ENABLED=true
SYSTEM_METRICS_INTERVAL_SEC=5.0

# --- Cross-camera ReID worker (Phase 2) ---
REID_WORKER_ENABLED=true
REID_CONSUMER_GROUP=reid-workers
REID_WINDOW_SEC=600
REID_MIN_SIMILARITY=0.55
REID_TOP_K=10
REID_SAME_CAMERA_DEDUP_SEC=30

# --- TimescaleDB hypertable on detection_events ---
# The 0003 migration creates the hypertable only if the timescaledb
# extension is already installed in the database. Set this flag to false
# to skip the conversion entirely on plain Postgres deployments.
TIMESCALEDB_ENABLED=true

# --- Thread pool sizing (override per-process if needed) ---
# VMS_INGEST_POOL_SIZE=256
# VMS_GPU_POOL_SIZE=4
# VMS_IO_POOL_SIZE=32

# --- API ---
API_HOST=0.0.0.0
API_PORT=8001
API_CORS_ORIGINS=*

# --- Auth (JWT HS256) ---
# REQUIRED in stage/prod. Min 32 chars; tokens minted by an upstream identity
# service signed with the same secret. Routes derive tenant_id from the `tid`
# claim — never a query string.
VMS_JWT_SECRET=
VMS_JWT_ALGORITHM=HS256
VMS_JWT_ISSUER=drisyam-vms
VMS_JWT_AUDIENCE=drisyam-vms
VMS_JWT_LEEWAY_SEC=30
# Dev-only escape hatch. When VMS_ENV=dev AND VMS_JWT_DEV_BYPASS=true,
# unauthenticated requests bind to the default tenant. Off in any env != dev.
VMS_JWT_DEV_BYPASS=false
# Pre-shared secret for the legacy AiFeed.jsx router. Empty disables that
# router entirely. Send via X-API-Key header.
LEGACY_API_KEY=

# --- Camera credential encryption (AES-256-GCM at rest) ---
# When unset, rtsp_url is stored plaintext (legacy mode). When set, new
# writes are encrypted and reads transparently decrypt. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# DO NOT rotate without a re-encrypt migration; v1 supports a single key.
VMS_CAMERA_CRED_KEY=

# --- OpenTelemetry distributed tracing ---
# Off by default (zero overhead). When enabled, FastAPI / SQLAlchemy / Redis
# auto-instrument and a single trace_id follows a face from orchestrator
# through the match worker to Postgres + Qdrant. Logs include trace_id when
# the active span is valid.
VMS_OTEL_ENABLED=false
VMS_OTEL_ENDPOINT=                       # OTLP gRPC, e.g. http://otel-collector:4317
VMS_OTEL_SERVICE_NAME=vms_face
VMS_OTEL_SAMPLE_RATIO=1.0

# --- Legacy compat (drives smart-cam-app/AiFeed.jsx) ---
MEDIAMTX_RTSP_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTSP_TEMPLATE=rtsp://{host}:{port}/{monitor_id}
DEFAULT_TENANT_NAME=drisyam-default
