# syntax=docker/dockerfile:1.6
#
# Face Reconstruction service — CodeFormer + Real-ESRGAN behind FastAPI.
#
# Sits next to smart-cam-ai in compose. It's a SEPARATE container on
# purpose:
#   - heavy model weights (~640 MB) we don't want bundled into the main
#     image
#   - older `basicsr` / `facelib` versioning conflicts with smart-cam-ai's
#     newer torch + onnxruntime stack
#   - GPU memory isolation: if CodeFormer OOMs on a 4K input, it crashes
#     this container only — smart-cam-ai keeps running
#
# Weight download happens at first container start (see entrypoint),
# stored on a persistent volume so subsequent restarts are fast.
# Official PyTorch base image. Includes:
#   - Python 3.11
#   - torch 2.7.x + torchvision (with sm_120 / Blackwell kernels — required
#     for RTX PRO 5000 Blackwell. PyTorch ≤ 2.5 only ships sm_50…sm_90 and
#     all GPU calls fail with "no kernel image is available for execution
#     on the device", which the pipeline's try/except silently swallows
#     and the response substitutes the CV stage-3 output for the GAN
#     reconstruction. The previous pin of 2.2.2 was for compatibility with
#     `torchvision.transforms.functional_tensor`, but grep shows nothing
#     in the actual deps (basicsr fork, realesrgan, facexlib) imports it —
#     the comment was stale.)
#   - CUDA 12.8 + cuDNN 9 runtime libs already wired
#
# Skipping the nvidia/cuda + pip-install-torch dance: the torch wheels +
# their nvidia-* transitive deps are ~2 GB and four consecutive builds
# failed on IncompleteRead halfway through downloads on this network.
# The official image ships all of that pre-baked, cutting build time
# and removing the flaky-link risk from the critical path entirely.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ARG DEBIAN_FRONTEND=noninteractive

# System deps:
#   - libgl1 + libglib2.0   OpenCV runtime libs (not in the base image)
#   - git                    basicsr's setup.py uses it
#   - wget                   model weight downloads in the entrypoint
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Resilient pip config. Still useful for the smaller deps we install
# on top of the base image (basicsr, facexlib, lpips, gdown, etc).
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5
RUN pip install --no-cache-dir --upgrade pip

# Install python deps. The backend ships its own requirements.txt; we
# also pin realesrgan + basicsr + facexlib explicitly because the
# pipeline.py imports them through monkey-patched basicsr modules.
COPY backend/requirements.txt /tmp/backend-reqs.txt
RUN pip install --no-cache-dir -r /tmp/backend-reqs.txt \
    && pip install --no-cache-dir realesrgan==0.3.0 basicsr==1.4.2 facexlib==0.3.0

WORKDIR /srv

# Copy CodeFormer first — it changes rarely. App code is copied last so
# editing pipeline.py or main.py doesn't bust the heavy layer above.
COPY CodeFormer /srv/CodeFormer
COPY backend /srv/backend

# Patch the bundled basicsr fork. CodeFormer ships a stripped-down
# basicsr that's missing files which its own __init__.py imports.
# Specifically:
#   - basicsr/version.py is normally generated by `pip install basicsr`
#     post-install hook; CodeFormer's bundled copy ships without it.
#   - basicsr/data/* is a whole directory CodeFormer pruned for size,
#     but basicsr/__init__.py reaches into it via `from .train import *`.
# pipeline.py monkey-patches the data submodules at runtime, but the
# `from .version import __gitsha__, __version__` line in basicsr/
# __init__.py runs BEFORE pipeline.py has any chance to patch.
# Cheapest fix: drop a stub version.py on disk.
RUN echo "__version__ = '1.4.2'" >  /srv/CodeFormer/basicsr/version.py \
 && echo "__gitsha__ = '0' * 40"  >> /srv/CodeFormer/basicsr/version.py \
 && echo "version_info = (1, 4, 2)" >> /srv/CodeFormer/basicsr/version.py

# Entrypoint downloads the model weights on first run (idempotent: it
# skips files that already exist on the mounted volume).
COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /srv/backend
EXPOSE 8002

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
