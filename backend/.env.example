# Drishyam backend — copy to backend/.env and edit.
#
# Inside docker compose, DB_*, REDIS_URL, SERVICE_TOKEN, AI_SERVICE_URL, CORS,
# FRONTEND_URL and the STREAM_SERVICE_* URLs are OVERRIDDEN by
# docker-compose.yml (from the root .env), so those values below only matter
# when running `npm run dev` directly on the host.
#
# src/config/env.js validates this file at boot and exits on any error.
# An optional key must be COMMENTED OUT, not left as `KEY=` — an empty
# string fails validation for most keys.

NODE_ENV=development
PORT=5000

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_NAME=drishyamvms
DB_USER=root
DB_PASSWORD=

# ── JWT (REQUIRED, >= 32 chars each: openssl rand -base64 48) ───────────────
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your-refresh-secret-key-must-be-at-least-32-chars-long
JWT_REFRESH_EXPIRES_IN=30d

# ── Service-to-service (must equal SERVICE_TOKEN in the root .env) ──────────
SERVICE_TOKEN=change-me-to-a-random-64-hex-string-0000000000000000000000000
AI_SERVICE_URL=http://localhost:8001

# ── Camera credential encryption at rest (AES-256-GCM, base64 of 32 bytes) ──
# openssl rand -base64 32. BACK IT UP: a lost key makes the stored camera
# passwords unrecoverable. Empty = plaintext.
CAMERA_CRED_KEY=

# ── Stream service (MediaMTX); user/pass must match mediamtx.yml ────────────
STREAM_SERVICE_API_URL=http://localhost:9997
STREAM_SERVICE_API_USER=drishyam
STREAM_SERVICE_API_PASS=drishyam123
# Production: the boot guard checks this legacy name (default drishyam123).
# Set it to the same rotated value as STREAM_SERVICE_API_PASS.
# MEDIAMTX_API_PASS=
STREAM_SERVICE_WEBRTC_URL=http://localhost:8889
STREAM_SERVICE_HLS_URL=http://localhost:8898
STREAM_SERVICE_RECORDINGS_DIR=../data/recordings

# ── CORS / frontend ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Payments (REQUIRED by validation; test placeholders are fine) ───────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Email (SMTP) — alert e-mails + password reset. Optional. ────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=noreply@your-domain.com

# ── S3-compatible object storage (cloud recording sync, downloads). Optional.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# ── LiveKit SFU. Optional. ──────────────────────────────────────────────────
# LIVEKIT_WS_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_TOKEN_TTL_SEC=3600

# ── TURN relay for WebRTC behind NAT. Optional (all four together). ────────
# TURN_URI=turn:turn.example.com:3478?transport=udp
# TURN_URI_TLS=turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=
# TURN_TTL_SEC=3600

# ── Other services (defaults shown; set only when they live elsewhere) ─────
# ACTIVITY_SERVICE_URL=http://activity-monitor:8000
# REDIS_URL=redis://localhost:6379
# AI_JWT_SECRET=                     # JWT the backend signs for the AI; falls back to SERVICE_TOKEN, then JWT_SECRET
# AI_JWT_ISSUER=drisyam-vms
# AI_JWT_AUDIENCE=drisyam-vms
# AI_SERVICE_TOKEN=                  # token the person-tracker sends us (alias PERSON_TRACKER_SERVICE_TOKEN)
# FACE_RECONSTRUCT_BASE=http://face-reconstruct:8002
# SMART_CAM_TRANSCODER_URL=http://smart-cam-transcoder:8004
# AI_MINIO_ENDPOINT=http://minio:9000  # AI snapshot store read for zone-intrusion evidence
# AI_MINIO_BUCKET=vms-snapshots
# AI_MINIO_KEY=
# AI_MINIO_SECRET=
# DB_SSL=false                       # true = TLS to MySQL
# DB_SSL_REJECT_UNAUTHORIZED=true    # false accepts a self-signed DB certificate
# STREAM_SERVICE_INTERNAL_HLS_URL=   # HLS URL the backend itself fetches (defaults to STREAM_SERVICE_HLS_URL)
# STREAM_SERVICE_RTSP_HOST=localhost # where ffmpeg/relay read cam_* paths over RTSP
# STREAM_SERVICE_RTSP_PORT=8554
# MEDIAMTX_RTSP_BASE=rtsp://mediamtx:8554  # Stream Service RTSP base used by NVR playback and site-relay replays
# Legacy aliases still honoured: MEDIAMTX_API_URL / _API_USER / _WEBRTC_URL /
# _HLS_URL / _INTERNAL_HLS_URL / _RTSP_HOST / _RTSP_PORT / _RECORDINGS_DIR
# (the STREAM_SERVICE_* name wins when both are set).
# STREAMING_ENGINE=mediamtx          # streaming backend implementation
# GIT_SHA=                           # version reported by /health (set at build)
# Legacy Shinobi VMS (unused by the current stack):
# SHINOBI_URL=http://localhost:8443
# SHINOBI_API_KEY=
# SHINOBI_SUPER_API_KEY=
# SHINOBI_GROUP_KEY=

# ── Recording (production values, as the server's .env runs them) ─────────
# 0 = delete a local segment once it is in S3; 1 = move it to <date>/archived/
RECORDING_KEEP_LOCAL=0
# Comma-separated user UUIDs whose cameras record MAIN continuously (empty = nobody)
RECORD_USER_IDS=
# Stream Service segment length for continuous recording
RECORDING_SEGMENT_DURATION=1m0s
# Segments shorter than this (s) are stitched together before upload
RECORDING_STITCH_BELOW_SEC=200
# Max total length (s) of one stitched clip
RECORDING_STITCH_MAX_BATCH_SEC=200
# RECORD_CONTINUOUS=0                # 1 = every camera records continuously (estate-wide; heavy)
# RECORD_SUB=0                       # 1 = also record the sub stream
# RECORD_DELETE_AFTER=168h           # Stream Service deletes its own segments after this
# RECORDING_MAX_BUFFER_MB=256        # in-memory upload fallback cap
# RECORDING_UPLOADED_CACHE_MAX=50000 # remembered uploaded-segment names (dedupe)
# RECORDING_PLAY_URL_TTL_SEC=14400   # presigned playback URL lifetime
# RECORDING_EXPORT_MAX_MS=1800000    # longest cloud clip export (30 min)
# DEFAULT_RETENTION_DAYS=30          # retention when a group sets none
# RETENTION_APPLY_CONCURRENCY=8
# RETENTION_APPLY_RETRIES=3
# RETENTION_APPLY_BACKOFF_MS=300
# S3_RETENTION_ENABLED=0             # 1 = sweep expired clips from S3
# S3_RETENTION_DELETE=0              # 1 = actually delete (else dry-run log)
# S3_RETENTION_GRACE_DAYS=1
# S3_RETENTION_INTERVAL_MS=86400000
# S3_RETENTION_MAX_DELETE_PER_RUN=20000
# WATCHDOG_NVR_RESET_MIN_MS=30000    # min gap between recording-watchdog NVR resets
# WATCHDOG_ORPHAN_CLEANUP=1          # 0 = keep Stream Service paths with no camera row
# WATCHDOG_ORPHAN_PASSES=2           # passes an orphan must be seen before removal
# WATCHDOG_ORPHAN_SKIP=demo-entrance # comma-separated path names never removed
# CLOUD_TIER_BYTES=10000000000000000 # denominator of the per-account cloud usage bar
# CLOUD_TIER_LABEL=10 PB
# CLOUD_CACHE_MS=180000              # per-account cloud usage cache
# STORAGE_CACHE_MS=60000             # disk snapshot cache

# ── Recording backfill from NVR HDD after outages (production values) ─────
# BACKFILL_ENABLED=1                 # 0 = off
# Only backfill relay-site gaps that began after this ISO time (empty = no floor)
BACKFILL_EDGE_SINCE=
# Concurrent NVR replays per site relay
BACKFILL_EDGE_PER_SITE=12
# How far back (h) relay-site gaps are backfilled
BACKFILL_EDGE_LOOKBACK_HOURS=336
# Minutes to pause a site's backfill after it starts dropping live streams
BACKFILL_EDGE_LIVE_PAUSE_MIN=3
# BACKFILL_INTERVAL_MIN=10
# BACKFILL_LOOKBACK_HOURS=24         # lookback for directly reachable NVRs
# BACKFILL_MIN_GAP_SEC=60            # smaller gaps are ignored
# BACKFILL_CHUNK_SEC=600
# BACKFILL_CLIP_SEC=180              # stored clip length
# BACKFILL_CONCURRENCY=4
# BACKFILL_PER_HOST=2
# BACKFILL_MAX_TRIES=3

# ── Site relays (edge) ─────────────────────────────────────────────────────
# Max concurrent replay jobs handed to one site relay
EDGE_MAX_JOBS_PER_SITE=13

# ── Live relay (fMP4 over WebSocket, /api/stream/live) ─────────────────────
# 1 = carry camera audio (G.711 -> AAC) in live view; 0 = video only
RELAY_AUDIO=0
# RELAY_IDLE_MS=30000                # stop a relay this long after its last viewer
# RELAY_MAX_GOP_FRAMES=800           # cached GOP size cap for instant start
# RELAY_SLOW_BYTES=2097152           # per-socket backlog before a viewer counts as slow
# RELAY_PROBESIZE=2000000
# RELAY_ANALYZE_DIRECT_US=1000000    # ffmpeg analyzeduration when pulling the NVR directly
# RELAY_TRACE=                       # any value = ffmpeg debug logging

# ── Live streaming tuning ──────────────────────────────────────────────────
# How long the MAIN (fullscreen) NVR pull is held after its last reader
MAIN_SOURCE_CLOSE_AFTER=30s
# Single-camera view: wait this long for main before serving the sub
MAIN_OPEN_BUDGET_MS=12000
# SOURCE_CLOSE_AFTER=5m              # same, for sub/other paths
# SOURCE_ALWAYS_ON=0                 # 1 = keep every source pulled
# PREFER_MAIN_STREAM=0               # 1 = grid uses main instead of sub
# GRID_LOW_TRANSCODE_MAX=2           # concurrent low-quality grid transcodes
# GRID_LOW_TRANSCODE_COOLDOWN_MS=15000
# STREAM_WARM=1                      # 0 = do not pre-warm a logged-in user's grid
# STREAM_WARM_LEASE_MS=180000
# STREAM_WARM_MAX=18
# STREAM_WARM_MAX_PER_HOST=9
# STREAM_WARM_TRANSCODE=0            # 1 = also warm H.264 sidecars
# STREAM_MAIN_PRIORITY_MS=90000      # warm streams yield to a main open for this long
# STREAM_URL_SECRET=                 # HMAC key (>= 16 chars) for signed stream URLs; empty = off
# STREAM_URL_TTL_SEC=3600
# STREAM_BUS_MAXLEN=50000            # Redis event-stream length cap
# TRANSCODER_MAX=8                   # concurrent ffmpeg transcoders
# TRANSCODER_QUEUE_CONCURRENCY=32
# TRANSCODER_QUEUE_WAIT_MS=10000
# TRANSCODER_IDLE_MS=60000
# TRANSCODER_STALL_MS=30000
# TRANSCODER_CHECK_MS=15000
# TRANSCODER_HEALTHY_RUN_MS=30000
# TRANSCODER_PROBESIZE=500000
# TRANSCODER_ANALYZE_US=500000
# TRANSCODER_ALLOW_HW=false          # true = allow GPU encoders
# NVR_OPEN_GAP_MS=300                # spacing between session opens on one NVR
# NVR_DOWN_WAIT_MS=60000             # back-off after an NVR refuses
# SUPERVISOR_POLL_MS=2000
# SUPERVISOR_MIN_BPS=20000
# SUPERVISOR_DEGRADED_AFTER_MS=20000
# SUPERVISOR_OFFLINE_AFTER_MS=40000
# SUPERVISOR_FLAP_WINDOW_MS=120000
# SUPERVISOR_FLAP_LIMIT=5
# SUPERVISOR_QUARANTINE_MS=300000
# SUPERVISOR_LEADER_TTL_MS=15000
# QUALITY_WINDOW_SAMPLES=30
# QUALITY_HEAL_AFTER_MS=30000
# QUALITY_HEAL_FIE_RATE=50
# QUALITY_WARN_FIE_RATE=5
# QUALITY_WARN_JITTER_MS=200
# QUALITY_HEAL_COOLDOWN_MS=60000
# QUALITY_HEAL_COOLDOWN_MAX_MS=900000
# QUALITY_HEAL_BUDGET_24H=20
# QUALITY_NVR_RECONNECT_MIN_MS=30000
# RECONCILE_ENABLED=1
# RECONCILE_INTERVAL_MS=60000
# RECONCILE_CONCURRENCY=8
# RECONCILE_DEBOUNCE_MS=1500
# CAMERA_PROBE_INTERVAL_MS=25000
# CAMERA_PROBE_TIMEOUT_MS=5000
# CAMERA_PROBE_PORT=554
# DEVICE_PROBE_TIMEOUT_MS=5000

# ── Alerts, AI events, occupancy, reports ──────────────────────────────────
# ALERT_PUSH_COOLDOWN_SEC=90
# ALERT_EMAIL_COOLDOWN_SEC=600
# ALERT_EMAIL_WINDOW_SEC=600
# ALERT_EMAIL_MAX_PER_WINDOW=8
# ALERT_TIMEZONE=Asia/Kolkata
# CAMERA_OFFLINE_ALERT_RESEND_MS=900000  # camera-down e-mail repeat interval
# AI_EVENT_DEDUP_SEC=120
# POSITIONAL_DEDUP_CELL_PX=64
# AI_EVENT_RETENTION_DAYS=90
# AI_EVENT_RETENTION_INTERVAL_MS=21600000
# AI_LIFECYCLE_RECONCILE_MS=15000
# AI_CLOCK_SKEW_WARN_SEC=10          # warn when the AI box clock drifts this far
# FACE_IMAGE_MAX_MB=20
# OCCUPANCY_ALERT_THRESHOLD=0        # 0 = off
# OCCUPANCY_GAUGE_TTL_SEC=30
# OCCUPANCY_CONFIRM_POLLS=3
# OCCUPANCY_CLEAR_MARGIN=5
# OCCUPANCY_EVAL_MS=10000
# OCCUPANCY_FLUSH_MS=60000
# OCCUPANCY_ROLLUP_MS=300000
# OCCUPANCY_TICK_SEC=5
# OCCUPANCY_STALE_AFTER_SEC=35
# OCCUPANCY_MINUTE_RETENTION_DAYS=90
# OCCUPANCY_CAMERA_MINUTE_RETENTION_DAYS=7
# PLATFORM_SERVICE_MONITOR=1         # 0 = do not monitor platform services
# REPORT_TZ_OFFSET=+05:30
# REPORT_PDF_SNAPSHOTS=on
# REPORT_PDF_MAX_EVENTS=30
# REPORT_PDF_MAX_EVIDENCE=6

# ── Licensing ──────────────────────────────────────────────────────────────
# ENFORCE_CAMERA_LIMITS=true         # false = no camera licence checks
# FREE_TIER_MAX_CAMERAS=0            # cap without a subscription (0 = unlimited)

# ── Scripts only (create-admin, smoke tests, diagnostics) ──────────────────
# ADMIN_EMAIL= / ADMIN_PASSWORD= / ADMIN_NAME=   scripts/create-admin.js
# SMOKE_API=http://localhost:5000/api            scripts/smoke-retention.js
# API_URL=http://localhost:5000/api / AUTH_TOKEN= src/scripts/diagnose-performance.js

# Live relay stall watchdog: restart a relay whose NVR session stays open but
# sends no video for this long (ms), or that has produced nothing 20 s after start.
# RELAY_STALL_MS=10000
# RELAY_NO_INIT_MS=20000
