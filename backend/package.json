{
  "name": "smart-cam-backend",
  "version": "1.1.0",
  "description": "DrishyamVMS Backend API - Enterprise Video Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "smoke:retention": "node scripts/smoke-retention.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all"
  },
  "keywords": [
    "vms",
    "video-management",
    "shinobi",
    "surveillance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/node-http-handler": "^3.370.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.17.1",
    "node-media-server": "^4.2.4",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.20.2",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.6",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "stripe": "^20.3.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "_overrides_note": "uuid pinned to patch the moderate advisory in sequelize's transitive dep (buffer bounds check). Safe patch bump; sequelize v6 works with uuid 11.x.",
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.5"
  }
}
