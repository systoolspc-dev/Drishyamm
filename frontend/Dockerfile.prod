FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL
ARG VITE_AI_BASE_URL
ARG VITE_STREAM_SERVICE_WEBRTC_BASE
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_AI_BASE_URL=$VITE_AI_BASE_URL VITE_STREAM_SERVICE_WEBRTC_BASE=$VITE_STREAM_SERVICE_WEBRTC_BASE
RUN npm run build -- --base=/
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
