# ═══════════════════════════════════════════════════════════════════════════
# Drishyam — compose-level settings. Copy to `.env` (git-ignored) and edit.
#   cp .env.example .env
# Backend-only settings (JWT, SMTP, S3, payments) live in backend/.env.
# Generate secrets with:  openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════

# ── Host addresses (what an operator's BROWSER uses) ────────────────────────
# Use this machine's LAN IP (or public hostname) instead of localhost if the
# console is opened from another computer.
HOST_IP=127.0.0.1
PUBLIC_API_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_HLS_URL=http://localhost:8898
PUBLIC_WEBRTC_URL=http://localhost:8889
CORS_ORIGINS=http://localhost:5173
TZ=Asia/Kolkata

# ── Shared service secret (REQUIRED, >= 32 chars) ───────────────────────────
# Backend → AI JWTs are signed with it and every AI service sends it as
# X-Service-Token to /api/internal/*. Compose feeds the SAME value to the
# backend (SERVICE_TOKEN) and the AI (VMS_JWT_SECRET), so they cannot drift.
SERVICE_TOKEN=change-me-to-a-random-64-hex-string-0000000000000000000000000

# AES-256-GCM key for camera RTSP URLs stored by the AI (base64 of 32 bytes:
# openssl rand -base64 32). Empty = stored in plaintext.
VMS_CAMERA_CRED_KEY=

# Auth posture of the AI API. dev = unauthenticated calls act as the default
# tenant (only honoured when VMS_ENV=dev). Production: VMS_ENV=prod.
VMS_ENV=dev
VMS_JWT_DEV_BYPASS=true
LEGACY_API_KEY=

# ── Datastores. Empty/default = dev (no auth). Set BEFORE first start; ─────
# changing them later needs ALTER USER / ALTER ROLE inside the containers.
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms
REDIS_PASSWORD=
# Host-side Redis port (containers always use redis:6379). Change it if this
# machine already runs its own Redis/Valkey on 6379.
REDIS_HOST_PORT=6379
QDRANT_API_KEY=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Recordings (stream service writes, backend + AI read) ───────────────────
RECORDINGS_DIR=./data/recordings

# ── AI tuning (defaults are what the running stack used) ────────────────────
# pyav = one CUDA context per process (required on Docker Desktop/WSL2).
# ffmpeg = one decoder process per camera, much less Python CPU (native Linux).
RTSP_INGEST_BACKEND=pyav
RTSP_HWACCEL=cuda
TENSORRT_ENABLED=true
ATTENTION_SCHEDULING=true
PIPELINE_PERSON_DETECTION_ENABLED=false
AI_DEFAULT_TENANT_NAME=drisyam-default

# zone-guard: `all` cameras, or a comma list of monitorIds. SOURCES overrides
# the RTSP URL per camera, e.g. <monitorId>=rtsp://stream-service:8554/demo_src
ZONE_GUARD_MONITORS=all
ZONE_GUARD_SOURCES=

# activity-monitor: door cameras (camera codes), named people that raise a
# CRITICAL alert when seen, business hours for after-hours alerts.
ACTIVITY_ENTRY_CAMERAS=
ACTIVITY_ALERT_WATCHLIST=
ACTIVITY_BUSINESS_HOURS=07:00-21:00

# ── Stream service control API (must match media/stream-service/mediamtx.yml)
STREAM_API_USER=drishyam
STREAM_API_PASS=drishyam123

# ── LiveKit SFU (optional, --profile media) ─────────────────────────────────
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cloudflare tunnel (optional, --profile tunnel) ──────────────────────────
CLOUDFLARED_DIR=./deploy/cloudflared/credentials
CLOUDFLARED_CONFIG=config.yml
